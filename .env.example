# adsb-monitor settings. Copy to .env and fill in for your station. Restart after changes:
#   pm2 restart adsb-monitor --update-env

# Where aircraft come from: piaware (your own receiver, below), or with no receiver a public aggregator for the area
# within RADIUS_NM of LAT/LON: adsb.lol (free; data is ODbL) or adsb.fi (personal, non-commercial use only). With an
# aggregator, LAT and LON are required, and the Coverage and SkyAware tabs are hidden.
SOURCE=piaware
RADIUS_NM=100

# Your PiAware (or other dump1090-fa / SkyAware) box, and where SkyAware lives on it.
PIAWARE=http://192.168.1.50
SKYAWARE_PATH=/skyaware/

# Receiver position (decimal degrees). Leave blank to use the one PiAware was set up with (receiver.json).
LAT=
LON=

# Your local airport, as an ICAO code (e.g. KBOS, EGLL, YSSY), for "watched flight landing" alerts.
# Name, position and elevation are looked up in OurAirports; the lines below override them if needed.
AIRPORT=
AIRPORT_NAME=
AIRPORT_IATA=
AIRPORT_LAT=
AIRPORT_LON=
AIRPORT_ELEV=

# Phone alerts: through Home Assistant (a webhook, see ha-automation.yaml) and/or ntfy (no HA needed: the ntfy app,
# subscribed to a topic with a long random name). Leave both blank to only log alerts (data/alerts.json, Alerts tab).
HA_WEBHOOK=
NTFY_URL=
# NTFY_URL=https://ntfy.sh/planes-pick-a-long-random-name
# Only for a protected ntfy server or topic:
NTFY_TOKEN=
# Opened when you tap an ntfy alert, e.g. this monitor's dashboard:
DASHBOARD_URL=

# Port for the dashboard (http://<this machine>:7100/), the API and the SkyAware proxy.
PORT=7100

# Starting alert distances (nm) and per-aircraft cooldown (h); change them later in the card's Alerts tab.
MILITARY_RADIUS=30
HELI_RADIUS=10
COOLDOWN_HOURS=2
# A military aircraft or helicopter within this many nm alerts again, despite the cooldown (at most hourly).
OVERHEAD_RADIUS=3
